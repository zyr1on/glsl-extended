{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GLSL",
  "scopeName": "source.glsl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#storage_modifiers" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#swizzles" },
    { "include": "#function_calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.glsl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.glsl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.glsl",
          "match": "^\\s*#\\s*(version|extension|include|define|undef|if|ifdef|ifndef|elif|else|endif|pragma|line|error)\\b.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.glsl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.glsl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.glsl",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.glsl",
          "match": "\\b0[xX][0-9a-fA-F]+[uU]?\\b"
        },
        {
          "name": "constant.numeric.float.glsl",
          "match": "\\b[0-9]+\\.[0-9]*([eE][+-]?[0-9]+)?[fF]?\\b|\\b\\.[0-9]+([eE][+-]?[0-9]+)?[fF]?\\b|\\b[0-9]+[eE][+-]?[0-9]+[fF]?\\b|\\b[0-9]+[fF]\\b"
        },
        {
          "name": "constant.numeric.integer.glsl",
          "match": "\\b[0-9]+[uU]?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.glsl",
          "match": "\\b(if|else|switch|case|default|for|while|do|break|continue|return|discard)\\b"
        },
        {
          "name": "keyword.other.struct.glsl",
          "match": "\\b(struct)\\b"
        }
      ]
    },
    "storage_modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.glsl",
          "match": "\\b(const|in|out|inout|centroid|sample|patch|smooth|flat|noperspective|uniform|buffer|shared|layout|attribute|varying|coherent|volatile|restrict|readonly|writeonly|precise|invariant)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.glsl",
          "match": "\\b(void|bool|int|uint|float|double)\\b"
        },
        {
          "name": "storage.type.vector.glsl",
          "match": "\\b([biud]?vec[234])\\b"
        },
        {
          "name": "storage.type.matrix.glsl",
          "match": "\\b([d]?mat[234](x[234])?)\\b"
        },
        {
          "name": "storage.type.sampler.glsl",
          "match": "\\b([iu]?sampler(1D|2D|3D|Cube|2DRect|1DArray|2DArray|Buffer|2DMS|2DMSArray|CubeArray)|sampler(1D|2D|Cube|2DRect|1DArray|2DArray|CubeArray)Shadow)\\b"
        },
        {
          "name": "storage.type.image.glsl",
          "match": "\\b([iu]?image(1D|2D|3D|Cube|2DRect|1DArray|2DArray|Buffer|2DMS|2DMSArray|CubeArray)|atomic_uint)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "variable.language.glsl",
          "match": "\\b(gl_Position|gl_PointSize|gl_ClipDistance|gl_CullDistance|gl_FragCoord|gl_FrontFacing|gl_PointCoord|gl_FragDepth|gl_SampleID|gl_SamplePosition|gl_SampleMaskIn|gl_SampleMask|gl_Layer|gl_ViewportIndex|gl_InvocationID|gl_PrimitiveID|gl_VertexID|gl_InstanceID|gl_DrawID|gl_BaseVertex|gl_BaseInstance|gl_NumWorkGroups|gl_WorkGroupSize|gl_WorkGroupID|gl_LocalInvocationID|gl_GlobalInvocationID|gl_LocalInvocationIndex)\\b"
        }
      ]
    },
    "swizzles": {
      "patterns": [
        {
          "name": "variable.other.member.swizzle.glsl",
          "match": "(?<=[A-Za-z0-9_\\)\\]])\\.([xyzw]{1,4}|[rgba]{1,4}|[stpq]{1,4})\\b"
        }
      ]
    },
    "function_calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.glsl" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.glsl",
          "match": "(\\+|-|\\*|\\/|%|==|!=|<=|>=|<|>|=|&&|\\|\\||!|&|\\||\\^|~|<<|>>|\\?|:)"
        }
      ]
    }
  }
}
